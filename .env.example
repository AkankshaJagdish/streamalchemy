# Twitch developer application
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Account that owns the channel and authorized the User Access Token
TWITCH_BROADCASTER_USER_ID=
TWITCH_BROADCASTER_LOGIN=
# Installed chatbot mode defaults to broadcaster account
TWITCH_BOT_USER_ID=

# Exact ID for the manually created "Gravity Curse" custom reward
TWITCH_GRAVITY_REWARD_ID=

# Generate with Twitch CLI after configuring the app:
# twitch token --user-token --scopes "user:read:chat channel:read:redemptions"
# No channel:manage:redemptions: redemption fulfillment is not enabled.
TWITCH_USER_ACCESS_TOKEN=

TWITCH_ENABLED=true
PORT=3000
HOST=127.0.0.1
OVERLAY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
