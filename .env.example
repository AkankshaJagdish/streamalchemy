# Twitch Developer Console application credentials
TWITCH_CLIENT_ID=
# Optional for this installed-chatbot + EventSub WebSocket configuration.
# Never expose this value to the overlay or commit a real value.
TWITCH_CLIENT_SECRET=

# Broadcaster authorization identity. For this MVP's installed-chatbot model,
# obtain the User Access Token while logged into the broadcaster account.
TWITCH_BROADCASTER_USER_ID=
TWITCH_BROADCASTER_LOGIN=

# Optional. Defaults to TWITCH_BROADCASTER_USER_ID because the chosen installed
# chatbot model reads chat as the broadcaster identity.
TWITCH_BOT_USER_ID=

# Twitch User Access Token generated with:
# twitch token --user-token --scopes "user:read:chat channel:read:redemptions"
TWITCH_USER_ACCESS_TOKEN=
