# Twitch Developer Console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_USER_ID=
TWITCH_BROADCASTER_LOGIN=
# Installed chatbot mode: bot ID defaults to broadcaster ID.
TWITCH_BOT_USER_ID=
# Exact custom reward ID for the manually created "Gravity Curse" reward.
TWITCH_GRAVITY_REWARD_ID=
# CLI: twitch token --user-token --scopes "user:read:chat channel:read:redemptions"
TWITCH_USER_ACCESS_TOKEN=

# Backend
TWITCH_ENABLED=true
PORT=3000
HOST=127.0.0.1
OVERLAY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
