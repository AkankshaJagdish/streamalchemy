# Local-only Twitch CLI mock EventSub configuration.
# This mode never calls Twitch authentication or subscription-registration APIs.
TWITCH_ENABLED=true
TWITCH_EVENTSUB_MODE=mock
TWITCH_EVENTSUB_WS_URL=ws://127.0.0.1:8080/ws

# Use the numeric broadcaster ID passed as --to-user to twitch event trigger.
TWITCH_BROADCASTER_USER_ID=

# Must exactly match the --item-id value in the Twitch CLI trigger command.
TWITCH_GRAVITY_REWARD_ID=11111111-1111-4111-8111-111111111111

PORT=3000
HOST=127.0.0.1
OVERLAY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
